---
/**
 * /news — the news feed's front page: the most recent posts in full (they run
 * 300–700 words, so a handful reads comfortably), then a pointer to the
 * archive. Posts live in src/content/blog/ (see docs/news-feed-content-brief.md).
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/Section.astro';
import Kicker from '@components/Kicker.astro';
import PostMeta from '@components/blog/PostMeta.astro';
import Prose from '@components/blog/Prose.astro';
import PostNotes from '@components/blog/PostNotes.astro';
import { news, colophon } from '@config/content';
import { site } from '@config/site';

const description =
  'News and notes from S.I.E.R.R.A — technology, preparedness, and lessons in emergency ' +
  'communications for the Calaveras & Tuolumne foothills.';

const allPosts = await getCollection('blog');
// Order by most-recent activity: a live bulletin's updatedDate bumps it to the top;
// normal posts (no updatedDate) sort by pubDate exactly as before.
const activity = (p: (typeof allPosts)[number]) => (p.data.updatedDate ?? p.data.pubDate).valueOf();
const all = allPosts.sort((a, b) => activity(b) - activity(a));
const recent = all.slice(0, news.recentCount);
const rendered = await Promise.all(recent.map(async (post) => ({ post, ...(await render(post)) })));

// The desk disclosure renders once at the feed footer (not per stacked post) when any shown
// post is an automated-desk post. (The emergency caveat is global chrome in SiteFooter.)
const feedHasDesk = recent.some((p) => p.data.author === colophon.deskName);

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: `News — ${site.name}`,
  url: `${site.url}/news`,
};
---

<BaseLayout title="News" description={description} path="/news" schema={pageSchema}>
  <Section surface="page" labelledby="blog-title">
    <div class="blog-layout">
      <header class="blog-head">
        <Kicker>{news.kicker}</Kicker>
        <h1 id="blog-title" class="blog-head__title">
          {news.title}
        </h1>
        <p class="blog-head__intro">{news.intro}</p>
        <p class="blog-head__live">
          {news.liveNote.text} <a href="/live">{news.liveNote.linkLabel}</a>.
        </p>
        <nav class="blog-head__links" aria-label="More news">
          <ul>
            <li>
              <a href="/news/archive">
                {news.links.archive}
                <span aria-hidden="true"> &rarr;</span>
              </a>
            </li>
            <li>
              <a href="/press">
                {news.links.press}
                <span aria-hidden="true"> &rarr;</span>
              </a>
            </li>
            <li>
              <a href="/rss.xml">
                <svg
                  class="blog-head__feed-icon"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20A2.18 2.18 0 0 1 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66A9.9 9.9 0 0 1 13.9 20h-2.84A7.06 7.06 0 0 0 4 12.94V10.1Z" />
                </svg>
                {news.links.feed}
              </a>
            </li>
          </ul>
        </nav>
      </header>

      <div class="blog-feed">
        {all.length === 0 && <p class="blog-empty">{news.emptyNote}</p>}
        {rendered.map(({ post, Content }) => (
          <article class="blog-post" aria-labelledby={`post-${post.id}`}>
            <PostMeta
              date={post.data.pubDate}
              updatedDate={post.data.updatedDate}
              tag={post.data.tag}
            />
            <h2 id={`post-${post.id}`} class="blog-post__title">
              <a href={`/news/${post.id}`}>{post.data.title}</a>
            </h2>
            {/* A live bulletin shows only its current-status head in the feed; the full
                timeline is on the permalink. Every other post renders in full as before. */}
            {post.data.summary ? (
              <div class="blog-post__fold">
                <Prose>
                  <p>{post.data.summary}</p>
                </Prose>
                <p class="blog-post__more">
                  <a href={`/news/${post.id}#timeline`}>
                    Read the full situation
                    <span aria-hidden="true"> →</span>
                  </a>
                </p>
              </div>
            ) : (
              <Prose>
                <Content />
              </Prose>
            )}
          </article>
        ))}
        <PostNotes desk={feedHasDesk} class="blog-feed__notes" />
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  /* Header in a sticky left rail, feed on the right — fills the desktop width
     the way the profile pages do. Stacks below 860px. */
  .blog-layout {
    display: grid;
    grid-template-columns: minmax(260px, 340px) 1fr;
    gap: var(--space-9);
    align-items: start;
  }

  .blog-head {
    position: sticky;
    top: calc(var(--topbar-h) + var(--space-5));
  }
  .blog-head__title {
    margin-top: var(--space-3);
    font-size: var(--fs-h2);
  }
  .blog-head__intro {
    margin-top: var(--space-4);
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
    color: var(--ink-body);
  }
  .blog-head__live {
    margin-top: var(--space-3);
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--ink-secondary);
  }
  .blog-head__live a {
    color: var(--brand-green);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .blog-head__live a:hover {
    color: var(--brand-green-hover);
  }

  /* Archive, press releases and the feed: three links at one weight, each a row under a
     hairline in the rail. Below 860px they run in a line so the first post stays close. */
  .blog-head__links {
    margin-top: var(--space-6);
  }
  .blog-head__links ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: var(--border-soft);
  }
  .blog-head__links li {
    border-top: var(--border-soft);
  }
  .blog-head__links a {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-3);
    font-family: var(--font-ui);
    font-size: var(--fs-label-lg);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--brand-green);
  }
  .blog-head__links a:hover {
    color: var(--brand-green-hover);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .blog-head__feed-icon {
    width: 1em;
    height: 1em;
    flex-shrink: 0;
  }

  .blog-empty {
    font-size: var(--fs-lead);
    color: var(--ink-secondary);
  }

  .blog-feed {
    max-width: 66ch;
    min-width: 0;
  }
  .blog-post + .blog-post {
    margin-top: var(--space-8);
    padding-top: var(--space-7);
    border-top: var(--border);
  }
  .blog-post__title {
    margin-top: var(--space-3);
    font-size: var(--fs-h3);
    line-height: var(--lh-heading);
  }
  .blog-post__title a {
    color: var(--ink-strong);
    text-decoration: none;
  }
  .blog-post__title a:hover {
    color: var(--brand-green);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* "Read the full situation →" — the feed fold's link into a live bulletin's timeline. */
  .blog-post__more {
    margin-top: var(--space-4);
    font-family: var(--font-ui);
    font-size: var(--fs-label-lg);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
  .blog-post__more a {
    color: var(--brand-green);
  }
  .blog-post__more a:hover {
    color: var(--brand-green-hover);
    text-decoration: none;
  }

  @media (max-width: 860px) {
    .blog-layout {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }
    .blog-head {
      position: static;
    }
    .blog-head__links ul {
      display: flex;
      flex-wrap: wrap;
      column-gap: var(--space-6);
      border-top: var(--border-soft);
    }
    .blog-head__links li {
      border-top: 0;
    }
  }
</style>
