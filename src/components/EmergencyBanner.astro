---
/**
 * EmergencyBanner — the site-wide alarm band (in BaseLayout, every page). Renders
 * nothing on calm days; when a hazard is active (an active evacuation or wildfire, a PG&E
 * Public Safety Power Shutoff at Warning stage or under way, or a severe NWS weather alert
 * in effect now — all area-scoped) it shows a slim orange band naming the hazard, linking to
 * the Live Feed (which carries the authoritative evacuation map). Priority: evacuation,
 * wildfire, PSPS, severe weather. Orange here is a sanctioned genuine-alert use. Client-only
 * (no baked data): SSR renders the band hidden + empty, and a client island checks the place
 * summary + wildfire layer (+ the power and weather_alert layers when the summary says a
 * PSPS or a severe alert is possible) on load + every 90s. What it shows, and when it
 * rewrites the role="alert" region, is decided in `src/lib/banner.ts`.
 */
import { HAZARD_AREA } from '@lib/hazards';
import { GRID_API_BASE } from '@lib/grid';
import { emergencyBanner as copy } from '@config/content';
---

<aside
  class="ebanner"
  data-ebanner
  data-area={HAZARD_AREA}
  data-api-base={GRID_API_BASE}
  role="alert"
  aria-label="Emergency alert"
  hidden
>
  <div class="ebanner__inner">
    <p class="ebanner__text">
      <span class="ebanner__icon" aria-hidden="true">
        ▲
      </span>
      <strong class="ebanner__label" data-ebanner-label></strong>
      <span data-ebanner-headline></span>
    </p>
    <span class="ebanner__actions">
      <a class="ebanner__link" href="/live">
        {copy.feedLabel} &rarr;
      </a>
    </span>
  </div>
</aside>

<script>
  import {
    deriveBanner,
    powerCheck,
    pspsFromLayer,
    weatherCheck,
    weatherFromLayer,
    type LayerCheck,
  } from '@lib/banner';
  import type { HazardFeature, SummaryDomain } from '@lib/hazards';

  const el = document.querySelector<HTMLElement>('[data-ebanner]');
  if (el) {
    const base = el.dataset.apiBase ?? 'https://data.sierragridteam.org/api/v1';
    const area = el.dataset.area ?? 'ebbetts-pass';

    // Publish the banner's rendered height as --banner-h so full-bleed pages can size
    // themselves to the space actually left over. /mesh fills the viewport below the nav,
    // and this band appears *above* <main> only during a life-safety event — without this
    // the mesh map overflowed the screen by exactly the banner's height whenever an
    // evacuation or wildfire was active. Defaults to 0px in tokens.css; a ResizeObserver
    // keeps it right when the headline wraps to two lines.
    const publishHeight = () => {
      const h = el.hidden ? 0 : el.getBoundingClientRect().height;
      document.documentElement.style.setProperty('--banner-h', `${Math.round(h)}px`);
    };
    new ResizeObserver(publishHeight).observe(el);
    let lastSig = '';
    // The last PSPS we could actually read. A failed power request, or a power source The
    // Grid marks UNAVAILABLE, is "unknown" — never a reason to take a shutoff banner down
    // (the one place this island holds a prior value rather than its hidden placeholder).
    let lastPsps: HazardFeature | null = null;
    // Likewise the last severe weather alert: an unreadable layer doesn't take it down. It
    // can't linger past the warning itself — deriveBanner drops it once `expires` has passed.
    let lastWeather: HazardFeature | null = null;
    const set = (sel: string, text: string) => {
      const t = el.querySelector<HTMLElement>(sel);
      if (t) t.textContent = text;
    };
    const accept = { headers: { accept: 'application/json' } };
    const refresh = async () => {
      try {
        const [sumRes, fireRes] = await Promise.all([
          fetch(`${base}/places/${area}/summary`, accept),
          fetch(`${base}/places/${area}/map/wildfire.geojson`, accept),
        ]);
        if (!sumRes.ok || !fireRes.ok) return;
        const s = (await sumRes.json()) as {
          summary?: {
            activeEvacuations?: number | null;
            topEvents?: { layer: string; headline: string }[];
          };
          domains?: SummaryDomain[];
        };
        const fire = (await fireRes.json()) as {
          features?: { properties?: { headline?: string } }[];
        };

        // Power and weather are separate signals: a failure here must not stop the evacuation
        // and wildfire checks, so each degrades to "unknown" (keep the last one read) rather
        // than throw. `null` is a confirmed "none", `undefined` is "couldn't read it".
        const read = async <T,>(
          check: LayerCheck,
          layer: string,
          pick: (body: Parameters<typeof pspsFromLayer>[0]) => T | undefined
        ): Promise<T | null | undefined> => {
          if (check === 'none') return null;
          if (check === 'unknown') return undefined;
          const res = await fetch(`${base}/places/${area}/map/${layer}.geojson`, accept).catch(
            () => null
          );
          return res?.ok ? pick(await res.json().catch(() => null)) : undefined;
        };
        const now = Date.now();
        const [psps, weather] = await Promise.all([
          read(powerCheck(s.domains), 'power', pspsFromLayer),
          read(weatherCheck(s.domains), 'weather_alert', (body) => weatherFromLayer(body, now)),
        ]);
        if (psps !== undefined) lastPsps = psps;
        if (weather !== undefined) lastWeather = weather;

        const banner = deriveBanner({
          activeEvacuations: s.summary?.activeEvacuations,
          topEvents: s.summary?.topEvents ?? [],
          wildfire: fire.features ?? [],
          psps: lastPsps,
          weather: lastWeather,
        });

        // Only touch the DOM when something actually changed — the role="alert" live
        // region must not re-announce on every 90s poll during a sustained emergency.
        if (banner.sig === lastSig) return;
        lastSig = banner.sig;

        if (!banner.active) {
          el.hidden = true;
          publishHeight();
          return;
        }
        set('[data-ebanner-headline]', banner.headline);
        set('[data-ebanner-label]', banner.label);
        el.hidden = false;
        publishHeight();
      } catch {
        /* keep the SSR banner state */
      }
    };
    refresh();
    setInterval(refresh, 90_000);
  }
</script>

<style>
  .ebanner {
    background: var(--signal-orange);
    color: var(--surface-page);
  }
  .ebanner[hidden] {
    display: none;
  }
  .ebanner__inner {
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--space-3) var(--gutter);
    display: flex;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    flex-wrap: wrap;
  }
  /* Inline within the text so it never wraps onto its own line on narrow screens —
     it sits as the leading glyph of the message and shrinks/wraps with it. */
  .ebanner__icon {
    margin-right: var(--space-2);
  }
  .ebanner__text {
    flex: 1 1 auto;
    min-width: 0;
    font-family: var(--font-ui);
    font-size: var(--fs-small);
    line-height: var(--lh-body);
  }
  .ebanner__label {
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    margin-right: var(--space-2);
  }
  .ebanner__actions {
    flex-shrink: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }
  .ebanner__link {
    color: var(--surface-page);
    font-family: var(--font-ui);
    font-size: var(--fs-label);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
  }
  .ebanner__link:hover {
    color: var(--surface-page);
    text-decoration: none;
  }
</style>
