---
/**
 * PressBlock — one labelled block of press material: a small tracked label over a rule,
 * then whatever the block holds (the About paragraphs, the media contact, the facts, the
 * logo links). The same block closes a release's own page (PressFoot) and builds /press,
 * so the two read as one set.
 */
interface Props {
  heading: string;
  /** id for the heading, when a landmark needs to point at it. */
  headingId?: string;
  /** Heading level — h2 at the page's top level, h3 when nested under one. */
  level?: 'h2' | 'h3';
}
const { heading, headingId, level: Heading = 'h2' } = Astro.props;
---

<div class="press-block">
  <Heading id={headingId} class="press-block__heading">
    {heading}
  </Heading>
  <div class="press-block__body">
    <slot />
  </div>
</div>

<style>
  .press-block__heading {
    padding-bottom: var(--space-2);
    border-bottom: var(--border);
    font-family: var(--font-ui);
    font-size: var(--fs-label-lg);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-secondary);
  }
  .press-block__body {
    margin-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--ink-body);
  }
  .press-block__body :global(a) {
    color: var(--brand-green);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .press-block__body :global(a:hover) {
    color: var(--brand-green-hover);
  }
</style>
